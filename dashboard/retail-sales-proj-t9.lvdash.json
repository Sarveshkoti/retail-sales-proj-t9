    },
    {
      "name": "8c0171eb",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "USE CATALOG `retail-sales-proj-t9`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    COUNT(*) AS total_anomalies_detected\n",
        "\n",
        "FROM gold.sales_anomalies\n",
        "\n",
        "WHERE anomaly_status = 'ANOMALY';"
      ]
    }
