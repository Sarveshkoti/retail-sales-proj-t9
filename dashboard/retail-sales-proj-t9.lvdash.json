        "\n",
        "FROM  `retail-sales-proj-t9`.logging.etl_log\n",
        "\n",
        "ORDER BY created_at DESC;"
      ]
    },
    {
      "name": "7606ccd3",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    validation_type,\n",
        "    validation_status,\n",
