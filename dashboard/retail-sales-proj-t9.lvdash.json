{
  "datasets": [
    {
      "name": "37065e7a",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    COUNT(*) AS total_active_customers\n",
        "FROM `retail-sales-proj-t9`.gold.dim_customer\n",
        "WHERE is_active = 1;"
      ]
    },
    {
      "name": "dae0ff66",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    COUNT(*) AS total_products\n",
        "FROM  `retail-sales-proj-t9`.gold.dim_product;"
      ]
    },
    {
      "name": "5ac46d5c",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    COUNT(*) AS total_stores\n",
        "FROM  `retail-sales-proj-t9`.gold.dim_store;"
      ]
    },
    {
      "name": "4e8b6525",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    SUM(quantity) AS total_sales_quantity\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales;"
      ]
    },
    {
      "name": "afe72081",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    s.region,\n",
        "    SUM(f.quantity) AS total_sales\n",
        "\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales f\n",
        "\n",
        "JOIN  `retail-sales-proj-t9`.gold.dim_store s\n",
        "\n",
        "ON f.store_id = s.store_id\n",
        "\n",
        "GROUP BY s.region\n",
        "\n",
        "ORDER BY total_sales DESC;"
      ]
    },
    {
      "name": "856f8d66",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    p.product_name,\n",
        "    SUM(f.quantity) AS total_sales\n",
        "\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales f\n",
        "\n",
        "JOIN  `retail-sales-proj-t9`.gold.dim_product p\n",
        "\n",
        "ON f.product_id = p.product_id\n",
        "\n",
        "GROUP BY p.product_name\n",
        "\n",
        "ORDER BY total_sales DESC\n",
        "\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "7de42eed",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    s.region,\n",
        "    SUM(f.quantity) AS total_sales\n",
        "\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales f\n",
        "\n",
        "JOIN  `retail-sales-proj-t9`.gold.dim_store s\n",
        "\n",
        "ON f.store_id = s.store_id\n",
        "\n",
        "GROUP BY s.region\n",
        "\n",
        "ORDER BY total_sales DESC;"
      ]
    },
    {
      "name": "09fcb345",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    s.region,\n",
        "    SUM(f.quantity) AS total_sales\n",
        "\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales f\n",
        "\n",
        "JOIN  `retail-sales-proj-t9`.gold.dim_store s\n",
        "\n",
        "ON f.store_id = s.store_id\n",
        "\n",
        "GROUP BY s.region\n",
