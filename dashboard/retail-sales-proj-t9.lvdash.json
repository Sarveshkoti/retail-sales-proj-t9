        "ORDER BY total_sales DESC;"
      ]
    },
    {
      "name": "da920023",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "\n",
        "    transaction_date,\n",
        "    SUM(quantity) AS total_sales\n",
        "\n",
        "FROM  `retail-sales-proj-t9`.gold.fact_sales\n",
        "\n",
        "GROUP BY transaction_date\n",
        "\n",
        "ORDER BY transaction_date;"
      ]
    },
    {
